FROM golang:1.10
WORKDIR /go/src/app
COPY source .
RUN go install -v
ENTRYPOINT ["app","-single=true","-port=8080"]
EOF

# 4. Build the image with the mandated image name and tag
docker build -t valkyrie-prod:v0.0.3 .

# 5. Verify the image creation
